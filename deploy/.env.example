# Local development only. Copy to .env and change every value.
#
# OPS-DEP-019: "Secrets MUST be injected at runtime from the secrets store and MUST NOT be present
# in container images, environment files committed to source, or orchestration manifests in
# plaintext." This file is the .example — it is committed and contains no secret. The .env you
# create from it is not committed and is still not a secrets store.
#
# OPS-DEP-020 goes further: long-lived process environment variables must not hold secrets,
# because an environment variable is readable from a process listing and appears in crash dumps.
# Everything below violates that. It is acceptable HERE because this is a local data tier holding
# no real finding, no evidence, and no customer credential. A deployment resolves these through
# the secrets contract of ADR-052 — and ⚠ OQ-026 (platform default vs enterprise vault) is still
# open, which is why no vault container appears in the compose file.

POSTGRES_DB=aspm
POSTGRES_SUPERUSER=aspm_owner
POSTGRES_SUPERUSER_PASSWORD=change-me-owner
POSTGRES_PORT=5432

# One per login role. Distinct values, so a leak of one is a leak of one.
APP_PASSWORD=change-me-app
MIGRATE_PASSWORD=change-me-migrate
VERIFY_PASSWORD=change-me-verify

VALKEY_PASSWORD=change-me-valkey

OBJECTSTORE_USER=aspm_objectstore
OBJECTSTORE_PASSWORD=change-me-objectstore
OBJECTSTORE_PORT=9000
OBJECTSTORE_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------------------------
# WHICH DEPLOYMENT THIS IS. Required — there is no default, because both things it controls fail
# in the dangerous direction if it is missing.
#
#   production   (or anything that is not 'development')
#       Session cookies are marked Secure, so SIGN-IN REQUIRES HTTPS. Put a TLS-terminating
#       ingress in front of the app and point it at 127.0.0.1:${APP_PORT}. Without HTTPS the
#       browser will not return the cookie and nobody can log in — that is the control working,
#       not a bug to route around.
#       The development header/cookie resolver REFUSES TO START in this mode.
#
#   development
#       Session cookies are not marked Secure, so the interface works over plain HTTP, and
#       ASPM_DEV_AUTH=true becomes available. That resolver takes identity from a header or from an
#       UNSIGNED base64 cookie carrying tenant, principal, permissions and scope — anyone who can
#       reach the port is anyone they choose to be. Only ever with fabricated data.
# ---------------------------------------------------------------------------------------------
ASPM_ENVIRONMENT=production

# ---------------------------------------------------------------------------------------------
# WHERE PUBLISHED PORTS BIND. Loopback by default (docker-compose.yml). Override only for an
# ingress that runs on another host, and never with 0.0.0.0.
# ---------------------------------------------------------------------------------------------
# APP_BIND=127.0.0.1
# POSTGRES_BIND=127.0.0.1
# OBJECTSTORE_BIND=127.0.0.1

# ASPM_DEV_AUTH is deliberately ABSENT. docker-compose.yml defaults it to false. Setting it here at
# all is a step towards leaving it set; if you need it, export it for the one command that needs it:
#     ASPM_DEV_AUTH=true docker compose up -d app
