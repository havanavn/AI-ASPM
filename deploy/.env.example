# Local development only. Copy to .env and change every value.
#
# OPS-DEP-019: "Secrets MUST be injected at runtime from the secrets store and MUST NOT be present
# in container images, environment files committed to source, or orchestration manifests in
# plaintext." This file is the .example — it is committed and contains no secret. The .env you
# create from it is not committed and is still not a secrets store.
#
# OPS-DEP-020 goes further: long-lived process environment variables must not hold secrets,
# because an environment variable is readable from a process listing and appears in crash dumps.
# Everything below violates that. It is acceptable HERE because this is a local data tier holding
# no real finding, no evidence, and no customer credential. A deployment resolves these through
# the secrets contract of ADR-052 — and ⚠ OQ-026 (platform default vs enterprise vault) is still
# open, which is why no vault container appears in the compose file.

POSTGRES_DB=aspm
POSTGRES_SUPERUSER=aspm_owner
POSTGRES_SUPERUSER_PASSWORD=change-me-owner
POSTGRES_PORT=5432

# One per login role. Distinct values, so a leak of one is a leak of one.
APP_PASSWORD=change-me-app
MIGRATE_PASSWORD=change-me-migrate
VERIFY_PASSWORD=change-me-verify

VALKEY_PASSWORD=change-me-valkey

OBJECTSTORE_USER=aspm_objectstore
OBJECTSTORE_PASSWORD=change-me-objectstore
OBJECTSTORE_PORT=9000
OBJECTSTORE_CONSOLE_PORT=9001
