{
  "$schema": "https://json.schemastore.org/sarif-2.1.0-rtm.5.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "semgrep",
          "semanticVersion": "1.45.0",
          "informationUri": "https://semgrep.dev",
          "rules": [
            {
              "id": "python.lang.security.audit.dangerous-subprocess-use.dangerous-subprocess-use",
              "name": "python.lang.security.audit.dangerous-subprocess-use.dangerous-subprocess-use",
              "shortDescription": { "text": "Detected subprocess function with user-controlled input" },
              "fullDescription": { "text": "Detected subprocess function 'run' with user-controlled input. This can lead to command injection." },
              "help": { "text": "Use shlex.quote or pass a list of arguments." },
              "helpUri": "https://semgrep.dev/r/python.lang.security.audit.dangerous-subprocess-use.dangerous-subprocess-use",
              "defaultConfiguration": { "level": "warning" },
              "properties": {
                "precision": "very-high",
                "tags": [ "CWE-78: Improper Neutralization of Special Elements used in an OS Command", "OWASP-A03:2021" ],
                "security-severity": "8.8"
              }
            },
            {
              "id": "python.flask.security.audit.debug-enabled.debug-enabled",
              "name": "python.flask.security.audit.debug-enabled.debug-enabled",
              "shortDescription": { "text": "Flask app runs with debug mode enabled" },
              "defaultConfiguration": { "level": "error" },
              "properties": { "tags": [ "CWE-489: Active Debug Code" ] }
            },
            {
              "id": "generic.secrets.security.detected-generic-api-key.detected-generic-api-key",
              "shortDescription": { "text": "Generic API key detected" },
              "defaultConfiguration": { "level": "warning" },
              "properties": { "security-severity": "9.4" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "python.lang.security.audit.dangerous-subprocess-use.dangerous-subprocess-use",
          "level": "warning",
          "message": { "text": "Detected subprocess function 'run' with user-controlled input." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/payments/refund.py", "uriBaseId": "%SRCROOT%" },
                "region": {
                  "startLine": 42,
                  "startColumn": 5,
                  "endLine": 42,
                  "endColumn": 48,
                  "snippet": { "text": "    subprocess.run(command, shell=True)" }
                }
              }
            }
          ],
          "fingerprints": { "matchBasedId/v1": "3c1f0d8a9b" },
          "partialFingerprints": { "primaryLocationLineHash": "9f8e7d6c:1" }
        },
        {
          "ruleId": "python.flask.security.audit.debug-enabled.debug-enabled",
          "message": { "text": "Flask app appears to be run with debug=True." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/payments/app.py" },
                "region": { "startLine": 118 }
              }
            }
          ]
        },
        {
          "ruleId": "generic.secrets.security.detected-generic-api-key.detected-generic-api-key",
          "level": "warning",
          "message": { "text": "Generic API key detected in source." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/payments/config/settings.py" },
                "region": {
                  "startLine": 7,
                  "snippet": { "text": "GATEWAY_KEY = \"sk_live_51H8xQ2eZvKYlo2C\"" }
                }
              }
            }
          ]
        },
        {
          "ruleId": "python.lang.correctness.useless-eqeq.useless-eqeq",
          "kind": "pass",
          "message": { "text": "No issue found." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/payments/util.py" },
                "region": { "startLine": 3 }
              }
            }
          ]
        }
      ]
    }
  ]
}
